# ==============================================================================
# AgriSense — Production Environment Configuration Example
# ==============================================================================

# Backend / API Settings
ENVIRONMENT=production
DATABASE_URL=sqlite:///./data/agrisense_production.db
REDIS_URL=redis://localhost:6379/0

# LLM Intelligence (Optional: Groq API key for customized deep reasoning)
GROQ_API_KEY=your_groq_api_key_here

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NODE_ENV=production

# NextAuth / Session Secret
NEXTAUTH_SECRET=agrisense_production_secret_key_change_me_in_prod
NEXTAUTH_URL=http://localhost:3000
